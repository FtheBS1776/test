+#[test]
+fn empty_capability_snapshot_precedes_buffered_turn_start() {
+    let context = CapabilitySnapshotContext {
+        logical_operation_id: "a".repeat(64),
+        executable_sha256: "b".repeat(64),
+        sandbox: "read-only".to_string(),
+        policy_sha256: "c".repeat(64),
+    };
+    let mut processor = EventProcessorWithJsonOutput::new_with_capability_snapshot(
+        /*last_message_path*/ None,
+        Some(context),
+    );
+    processor.pending_turn_started = true;
+    let marker = json!({
+        "logical_operation_id": "a".repeat(64),
+        "model": "gpt-5.6-sol",
+        "tools": [],
+    });
+    let collected = processor.collect_warning(format!(
+        "{}{}",
+        codex_core::CAPABILITY_SNAPSHOT_MARKER_PREFIX,
+        marker
+    ));
+
+    assert_eq!(collected.events.len(), 2);
+    let ThreadEvent::CapabilitySnapshot(event) = &collected.events[0] else {
+        panic!("expected capability snapshot");
+    };
+    assert_eq!(event.snapshot.tool_count, 0);
+    assert!(event.snapshot.tools.is_empty());
+    assert!(matches!(collected.events[1], ThreadEvent::TurnStarted(_)));
+}
