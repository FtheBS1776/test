+fn capability_snapshot_context(
+    config: &Config,
+    logical_operation_id: Option<&str>,
+) -> anyhow::Result<Option<event_processor_with_jsonl_output::CapabilitySnapshotContext>> {
+    let Some(logical_operation_id) = logical_operation_id else {
+        return Ok(None);
+    };
+    anyhow::ensure!(
+        logical_operation_id.len() == 64
+            && logical_operation_id.bytes().all(|byte| byte.is_ascii_hexdigit()),
+        "capability snapshot operation id must be a 64-character hexadecimal digest"
+    );
+    let sandbox = sandbox_mode_from_permission_profile(
+        &config.permissions.effective_permission_profile(),
+        config.cwd.as_path(),
+    )
+    .ok_or_else(|| anyhow::anyhow!("capability snapshot requires a concrete sandbox mode"))?
+    .to_string();
+    let executable = std::env::current_exe()?;
+    let mut source = std::fs::File::open(executable)?;
+    let mut hasher = Sha256::new();
+    let mut buffer = [0_u8; 1024 * 1024];
+    loop {
+        let read = source.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&buffer[..read]);
+    }
+    Ok(Some(
+        event_processor_with_jsonl_output::CapabilitySnapshotContext {
+            logical_operation_id: logical_operation_id.to_ascii_lowercase(),
+            executable_sha256: format!("{:x}", hasher.finalize()),
+            sandbox,
+            policy_sha256: format!(
+                "{:x}",
+                Sha256::digest(br#"{"allowed_tools":[]}"#)
+            ),
+        },
+    ))
+}
